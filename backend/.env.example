# Application Settings
APP_NAME=Intelligent Lighting System
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lighting_db

# Redis
REDIS_URL=redis://localhost:6379

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Audio Analysis
AUDIO_SAMPLE_RATE=44100
AUDIO_CHUNK_SIZE=2048
AUDIO_HOP_LENGTH=512
AUDIO_CAPTURE_AUTO_START=false

# ML Models
BEATNET_MODEL_PATH=ml_models/beatnet/model.pt
HUBERT_MODEL_PATH=ml_models/hubert/model.pt
YOLO_MODEL_PATH=ml_models/yolov9/model.pt

# DMX/ArtNet
ARTNET_IP=0.0.0.0
ARTNET_PORT=6454
DMX_UNIVERSE=0
DMX_FPS=40

# WebSocket
WS_HEARTBEAT_INTERVAL=30
